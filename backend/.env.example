APP_ENV=development
# These starter values are local-development friendly. Replace placeholder hostnames
# and demo secrets before using this outside local development.
APP_NAME=Amon API
APP_VERSION=0.1.0
# External product API origin. Use a placeholder such as https://api.example.com
# outside local development.
API_EXTERNAL_ORIGIN=http://127.0.0.1:8000
# External visible ops URL. Use a placeholder such as
# https://ops.example.com/ops/ outside local development.
OPS_SURFACE_ORIGIN=http://127.0.0.1:8000/ops/
# Current backend mount for the ops surface. Keep this at /ops in this repo.
OPS_BACKEND_PATH_PREFIX=/ops
DATABASE_URL=sqlite:///./amon_server.db
SEARCH_PROVIDER=mock
BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com
BRAVE_TIMEOUT_SECONDS=15
REQUESTS_PER_MINUTE=60
SESSION_TTL_HOURS=24
ROUTE_SESSION_TTL_SECONDS=300
ROUTE_SESSION_REFRESH_LEEWAY_SECONDS=90
# Local-demo-only example. Replace or remove for non-local use.
ROUTE_RELAY_SHARED_SECRET=amon-route-relay-dev
PUBLIC_SITE_ORIGINS=https://www.example.com,https://example.com
# Add local dashboard origins here if you use the standalone frontend on port 3000.
OPS_FRONTEND_ORIGINS=https://ops.example.com
CORS_ALLOW_ORIGINS=
TRUSTED_HOST_PATTERNS=127.0.0.1,localhost,api.example.com,ops.example.com
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Local-demo-only example. Replace or remove for non-local use.
INTERNAL_ADMIN_TOKEN=amon-internal-dev
OPS_SESSION_COOKIE_SECURE=
OPS_SESSION_COOKIE_DOMAIN=
OPS_SESSION_COOKIE_SAME_SITE=lax
OPS_ALLOW_DEV_TOKEN_LOGIN=false
OPS_TRUSTED_PROXY_SECRET=
# Optional explicit mode: disabled, shared_secret_headers, asserted_identity_headers
OPS_TRUSTED_UPSTREAM_IDENTITY_MODE=
OPS_TRUSTED_UPSTREAM_SECRET_HEADER=X-Amon-Ops-Proxy-Secret
OPS_TRUSTED_UPSTREAM_OPERATOR_ID_HEADER=X-Amon-Operator-Id
# Optional asserted provider: generic, cloudflare_access
OPS_TRUSTED_UPSTREAM_ASSERTED_PROVIDER=generic
# Generic asserted identity header. For cloudflare_access, the default becomes Cf-Access-Authenticated-User-Email.
OPS_TRUSTED_UPSTREAM_ASSERTED_OPERATOR_ID_HEADER=X-Amon-Operator-Identity
# Cloudflare Access JWT assertion header. Used when
# OPS_TRUSTED_UPSTREAM_ASSERTED_PROVIDER=cloudflare_access.
OPS_TRUSTED_UPSTREAM_CLOUDFLARE_ACCESS_JWT_HEADER=Cf-Access-Jwt-Assertion
OPS_ENVIRONMENT_KEY=local
OPS_ENVIRONMENT_LABEL=Local
