APP_ENV=development
APP_NAME=Amon API
APP_VERSION=0.1.0
API_EXTERNAL_ORIGIN=http://127.0.0.1:8000
OPS_SURFACE_ORIGIN=http://127.0.0.1:8000/ops/
DATABASE_URL=sqlite:///./amon_server.db
SEARCH_PROVIDER=mock
BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com
BRAVE_TIMEOUT_SECONDS=15
REQUESTS_PER_MINUTE=60
SESSION_TTL_HOURS=24
PUBLIC_SITE_ORIGINS=https://www.getamon.com,https://getamon.com
OPS_FRONTEND_ORIGINS=https://ops.getamon.com,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=
TRUSTED_HOST_PATTERNS=127.0.0.1,localhost,api.getamon.com,ops.getamon.com
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
OPS_SESSION_COOKIE_SECURE=
OPS_SESSION_COOKIE_DOMAIN=
OPS_SESSION_COOKIE_SAME_SITE=lax
OPS_ALLOW_DEV_TOKEN_LOGIN=false
OPS_ENVIRONMENT_KEY=local
OPS_ENVIRONMENT_LABEL=Local
